-- 09  Probability and statistics with exact symbolic computation
)clear all

-- Moment generating function of the exponential distribution
pdf := lambda*exp(-lambda*x)
-- E[exp(t X)] is a Laplace transform evaluated at s = -t
-- (valid for t < lambda)
M := eval(laplace(pdf, x, s), s = -t)
-- Moments: E[X^k] = k-th derivative of M at t = 0
[eval(D(M, t, k), t = 0) for k in 1..4]

-- Cumulants of a Poisson(mu) variable from K(t) = log M(t):
-- K'(0) is the mean, K''(0) the variance, K'''(0) the third cumulant
Mp := exp(mu*(exp(t) - 1))
K := log Mp
[eval(D(K, t, j), t = 0) for j in 1..3]

-- Exact probabilities with rationals: P(sum of two dice = 7)
-- Nest the comprehensions (two 'for' clauses in one bracket would zip)
outcomes := concat [[i + j for j in 1..6] for i in 1..6]
count(s +-> s = 7, outcomes) / #outcomes

-- Normal distribution: the normalising constant is sqrt(2 pi)
integrate(exp(-x^2/2), x = %minusInfinity..%plusInfinity, "noPole")
-- E[X^2] integral gives the same sqrt(2 pi), so after normalising Var(X) = 1
integrate(x^2*exp(-x^2/2), x = %minusInfinity..%plusInfinity, "noPole")

-- Binomial coefficients and Stirling's approximation
binomial(50, 25)
(factorial(100) :: Float) / (sqrt(2*%pi*100.0) * (100.0/%e)^100)
